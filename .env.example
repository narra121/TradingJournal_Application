#############################################
# Environment configuration example
# Copy to .env.development and .env.production
# Replace <dev-api-id> / <prod-api-id> and adjust region if needed.
#############################################

# Development (dev stage) API URL
# Example provided by user request:
# https://ok0cbhdbf3.execute-api.us-east-1.amazonaws.com/dev/v1
VITE_API_BASE_URL=https://ok0cbhdbf3.execute-api.us-east-1.amazonaws.com/dev/v1

# For production build create .env.production with:
# VITE_API_BASE_URL=https://<prod-api-id>.execute-api.us-east-1.amazonaws.com/prod/v1
